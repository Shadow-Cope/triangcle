{
  "name": "triancle-desktop",
  "productName": "Triancle",
  "version": "1.0.4",
  "description": "Triancle desktop app (Windows and macOS)",
  "author": "Triancle",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.triancle.app",
    "productName": "Triancle",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "config.json", "build/icon.png", "package.json"],
    "protocols": [{ "name": "Triancle", "schemes": ["triancle"] }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Triancle-Setup.${ext}"
    },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "runAfterFinish": true },
    "mac": {
      "category": "public.app-category.games",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "artifactName": "Triancle-mac.${ext}"
    },
    "dmg": { "title": "Triancle" }
  }
}
