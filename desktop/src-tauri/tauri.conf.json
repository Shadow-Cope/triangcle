{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triancle",
  "version": "1.9.5",
  "identifier": "com.triancle.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Triancle desktop game app",
    "longDescription": "The official desktop shell for playing Triancle games.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {"width": 660, "height": 400},
        "appPosition": {"x": 180, "y": 170},
        "applicationFolderPosition": {"x": 480, "y": 170}
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["triancle"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Shadow-Cope/triangcle/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNDdENDRDMzA4OUFBOUQKUldTZHFva3dUTlJISVNHZFFKNGdTemM2OHdjQ1NEbmkyT2lhaUE2Rk9zYTBMYmtYNVlpaEVPd1MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
