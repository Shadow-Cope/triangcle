{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triancle Studio",
  "version": "1.0.8",
  "identifier": "com.triancle.studio",
  "bundle": {
    "shortDescription": "Triancle Studio - make your own Triancle games",
    "longDescription": "The first version of Triancle Studio: create a game, fly the studio camera and start building on a baseplate.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["triancle-studio"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Shadow-Cope/triangcle/releases/latest/download/latest-studio.json"
      ]
    }
  }
}
